export global Skin {
    out property <color> canvas: #f6f8f5;
    out property <color> paper: #ffffff;
    out property <color> ink: #20332b;
    out property <color> muted: #52675b;
    out property <color> border: #d8e2d9;
    out property <color> accent: #23684c;
    out property <color> tint: #e6f2e7;
    out property <color> danger: #a03e39;
}

export global Paths {
    out property <string> leaf: "M4 19 C2 12 5 5 12 4 C15 3.5 18 4 21 2.5 C21.5 10 19.5 17 13 19 C10 20 7 19 6 18 M3 22 C5 17 10 13 16 8";
    out property <string> plus: "M12 4 V20 M4 12 H20";
    out property <string> import: "M12 2 V14 M7 9 L12 14 L17 9 M4 14 V20 H20 V14";
    out property <string> picture: "M3 4 H21 V20 H3 Z M4 17 L9 12 L13 15 L16 11 L21 16 M8 8 H10";
    out property <string> screen: "M3 4 H21 V16 H3 Z M12 16 V21 M7 21 H17";
    out property <string> edit: "M4 16 L15 5 L19 9 L8 20 L3 21 Z M15 5 L17 3 Q18 2 19 3 L21 5 Q22 6 21 7 L19 9";
    out property <string> trash: "M3 6 H21 M9 6 V3 H15 V6 M6 6 L7 21 H17 L18 6 M10 10 V17 M14 10 V17";
    out property <string> search: "M16 16 L21 21 M18 10 C18 14.4 14.4 18 10 18 C5.6 18 2 14.4 2 10 C2 5.6 5.6 2 10 2 C14.4 2 18 5.6 18 10 Z";
}

export component Glyph inherits Path {
    in property <string> data;
    in property <color> ink: Skin.ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.data;
    fill: transparent;
    stroke: root.ink;
    stroke-width: 1.7px;
    accessible-role: none;
}

export component Action inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> kind: "normal";
    in property <bool> icon-only: false;
    in property <bool> enabled: true;
    callback triggered();
    private property <bool> solid: kind == "primary" || kind == "destructive";
    private property <color> foreground: root.solid ? white : root.kind == "danger" ? Skin.danger : Skin.ink;
    preferred-width: root.icon-only ? 34px : content.min-width + 24px;
    min-width: root.icon-only ? 32px : content.min-width + 20px;
    height: root.icon-only ? 32px : 36px;
    horizontal-stretch: 0;
    border-radius: 7px;
    border-width: keyboard.has-focus ? 2px : 1px;
    border-color: keyboard.has-focus ? #4c9476 : root.solid || root.icon-only || root.kind == "quiet" ? transparent : Skin.border;
    background: root.kind == "primary" ? (hit.has-hover ? #19583e : Skin.accent)
        : root.kind == "destructive" ? (hit.has-hover ? #88302d : Skin.danger)
        : hit.has-hover ? (root.kind == "danger" ? #f9e8e5 : Skin.tint)
        : root.icon-only || root.kind == "quiet" ? transparent : Skin.paper;
    opacity: root.enabled ? 1 : 0.48;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.triggered(); } }
    forward-focus: keyboard;

    content := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.glyph != "": Glyph {
            y: (parent.height - self.height) / 2;
            data: root.glyph; ink: root.foreground; width: 17px; height: 17px;
        }
        if !root.icon-only: Text {
            text: root.label; color: root.foreground;
            font-size: 13px; font-weight: 600; vertical-alignment: center;
        }
    }
    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Space || e.text == Key.Return { root.triggered(); return accept; }
            return reject;
        }
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.triggered(); }
    }
}

export component CopyTarget inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback copied();
    border-radius: 7px;
    background: hit.has-hover ? Skin.tint : transparent;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: #4c9476;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.copied(); } }
    forward-focus: keyboard;
    @children
    keyboard := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Space || e.text == Key.Return { root.copied(); return accept; }
            return reject;
        }
    }
    hit := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.copied(); }
    }
}

export component Caption inherits Text {
    height: 20px;
    color: Skin.muted;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
}

export component Heading inherits Text {
    height: 35px;
    font-size: 24px;
    font-weight: 700;
    color: Skin.ink;
    vertical-alignment: center;
}

export component Paper inherits Rectangle {
    background: Skin.paper;
    border-width: 1px;
    border-color: Skin.border;
    border-radius: 10px;
}
