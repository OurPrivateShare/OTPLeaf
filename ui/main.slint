import { ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { Action, Caption, CopyTarget, Glyph, Heading, Paper, Paths, Skin } from "./widgets.slint";

export struct AccountRow {
    id: string, name: string, masked-secret: string, code: string, remaining: int,
    period: int, algorithm: string, digits: int,
}
export struct EntryDraft {
    id: string, name: string, secret: string, digits: string, period: string, algorithm: string,
}

// An edit breaks the LineEdit's initial binding. Rebind incoming drafts when
// reviewing the next QR code without closing the editor.
component DraftInput inherits LineEdit {
    in property <string> draft-value;
    text: root.draft-value;
    changed draft-value => {
        if root.text != root.draft-value { root.text = root.draft-value; }
    }
}

component TokenCard inherits Paper {
    in property <AccountRow> account;
    in property <bool> can-copy;
    in property <bool> can-edit;
    callback copy-code();
    callback copy-secret();
    callback edit();
    callback remove();
    height: 70px;

    HorizontalLayout {
        padding-left: 15px; padding-right: 9px; spacing: 6px;
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1; min-width: 48px;
            Text {
                text: root.account.name;
                font-size: 15px; font-weight: 650; color: Skin.ink;
                height: 23px; min-width: 0px; overflow: elide; vertical-alignment: center;
            }
            Text {
                text: root.account.algorithm + "  ·  " + root.account.digits + " 位";
                color: Skin.muted; font-size: 12px; height: 18px;
                min-width: 0px; overflow: elide; vertical-alignment: center;
            }
        }
        CopyTarget {
            y: (parent.height - self.height) / 2; height: 52px; width: 122px;
            label: "复制 " + root.account.name + " 的密钥"; enabled: root.can-copy;
            copied => { root.copy-secret(); }
            VerticalLayout {
                alignment: center; padding-left: 5px; padding-right: 5px;
                Text {
                    text: "密钥"; font-size: 11px; color: Skin.muted;
                    height: 17px; vertical-alignment: center;
                }
                Text {
                    text: root.account.masked-secret; font-size: 13px; font-weight: 600;
                    height: 23px; color: Skin.ink; min-width: 0px; overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        CopyTarget {
            y: (parent.height - self.height) / 2; width: 138px; height: 55px;
            label: "复制 " + root.account.name + " 的验证码"; enabled: root.can-copy;
            copied => { root.copy-code(); }
            VerticalLayout {
                padding-left: 5px; padding-right: 5px; alignment: center;
                Text {
                    text: root.account.code; font-size: 22px; font-weight: 700;
                    color: Skin.accent; height: 30px; vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 7px; height: 15px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 4px; border-radius: 2px; background: #e2ebe2;
                        Rectangle {
                            x: 0px; height: parent.height; border-radius: 2px;
                            width: parent.width * min(1, max(0, root.account.remaining / max(1, root.account.period)));
                            background: root.account.remaining <= 5 ? #b57a37 : #69a380;
                        }
                    }
                    Text {
                        text: root.account.remaining + " s"; color: Skin.muted;
                        font-size: 11px; min-width: 27px; horizontal-alignment: right; vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { y: (parent.height - self.height) / 2; width: 1px; height: 25px; background: Skin.border; }
        HorizontalLayout {
            y: (parent.height - self.height) / 2; height: 32px;
            Action {
                label: "编辑 " + root.account.name; glyph: Paths.edit; icon-only: true; enabled: root.can-edit;
                triggered => { root.edit(); }
            }
            Action {
                label: "删除 " + root.account.name; glyph: Paths.trash; icon-only: true; kind: "danger"; enabled: root.can-edit;
                triggered => { root.remove(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.app-version == "" ? "OTPLeaf" : "OTPLeaf " + root.app-version;
    icon: @image-url("../assets/otpleaf.png");
    min-width: 560px;
    min-height: 430px;
    preferred-width: 620px;
    preferred-height: 520px;
    background: Skin.canvas;
    default-font-size: 14px;

    in property <string> app-version;
    in-out property <[AccountRow]> rows;
    in-out property <int> total-count;
    in-out property <string> query;
    in-out property <string> page: "accounts";
    in-out property <EntryDraft> draft;
    in-out property <string> edit-error;
    in-out property <string> feedback;
    in-out property <string> pending-name;
    in-out property <bool> busy;
    private property <string> link;
    private property <bool> modal: root.page != "accounts";
    private property <bool> can-edit: !root.modal && !root.busy;

    callback search(string);
    callback add-entry();
    callback edit-entry(string);
    callback save-entry(EntryDraft);
    callback cancel-edit();
    callback ask-delete(string);
    callback confirm-delete();
    callback copy-code(string);
    callback copy-secret(string);
    callback import-uri(string);
    callback import-image();
    callback scan-screen();
    callback quit-app();

    function close-dialog() {
        if root.page == "edit" { root.cancel-edit(); }
        root.edit-error = "";
        root.feedback = "";
        root.page = "accounts";
    }
    changed page => {
        if root.page != "import" { root.link = ""; }
        if !root.modal { search-input.focus(); }
    }

    VerticalLayout {
        Rectangle {
            height: 60px; background: Skin.paper;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 6px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 30px; height: 30px; border-radius: 9px; background: Skin.accent;
                    Glyph { x: 5px; y: 5px; width: 20px; height: 20px; data: Paths.leaf; ink: white; }
                }
                Text { text: "OTPLeaf"; font-size: 20px; font-weight: 700; color: Skin.ink; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Action {
                    y: (parent.height - self.height) / 2;
                    glyph: Paths.import; label: "导入条目"; enabled: root.can-edit;
                    triggered => { root.edit-error = ""; root.feedback = ""; root.page = "import"; }
                }
                Action {
                    y: (parent.height - self.height) / 2;
                    glyph: Paths.picture; label: "打开图片"; enabled: root.can-edit;
                    triggered => { root.import-image(); }
                }
                Action {
                    y: (parent.height - self.height) / 2;
                    glyph: Paths.screen; label: "识别屏幕"; enabled: root.can-edit;
                    triggered => { root.scan-screen(); }
                }
                Action {
                    y: (parent.height - self.height) / 2;
                    glyph: Paths.plus; label: "添加条目"; kind: "primary"; enabled: root.can-edit;
                    triggered => { root.add-entry(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Skin.border; }
        }
        VerticalLayout {
            padding: 16px; padding-bottom: 0px; spacing: 12px;
            HorizontalLayout {
                spacing: 12px; height: 36px;
                search-input := LineEdit {
                    placeholder-text: "搜索条目名称"; accessible-label: "搜索条目名称";
                    text <=> root.query; enabled: !root.modal; height: 36px;
                    edited(value) => { root.search(value); }
                }
                Text {
                    text: root.query == "" ? root.total-count + " 项" : root.rows.length + " / " + root.total-count + " 项";
                    vertical-alignment: center; font-size: 13px; color: Skin.muted;
                    horizontal-stretch: 0;
                }
            }
            if root.rows.length > 0: ListView {
                vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                for item in root.rows: Rectangle {
                    height: 78px;
                    TokenCard {
                        width: parent.width; account: item; can-copy: !root.modal; can-edit: root.can-edit;
                        copy-secret => { root.copy-secret(item.id); }
                        copy-code => { root.copy-code(item.id); }
                        edit => { root.edit-entry(item.id); }
                        remove => { root.ask-delete(item.id); }
                    }
                }
            }
            if root.rows.length == 0: Paper {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center; spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 55px; height: 55px; border-radius: 16px; background: Skin.tint;
                            Glyph {
                                x: 13px; y: 13px; width: 29px; height: 29px; ink: Skin.accent;
                                data: root.query == "" ? Paths.leaf : Paths.search;
                            }
                        }
                    }
                    Text {
                        text: root.query == "" ? "添加第一个验证码" : "没有匹配的条目";
                        height: 30px; font-size: 18px; font-weight: 650;
                        color: Skin.ink; horizontal-alignment: center; vertical-alignment: bottom;
                    }
                    Text {
                        text: root.query == "" ? "手动输入密钥，或导入已有的验证器二维码。" : "试试其他名称。";
                        color: Skin.muted; height: 23px; font-size: 13px; horizontal-alignment: center;
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 35px; vertical-stretch: 0;
            padding-left: 17px; padding-right: 11px; spacing: 12px;
            Text {
                text: root.modal ? "" : root.edit-error != "" ? root.edit-error : root.feedback != "" ? root.feedback
                    : root.busy ? "正在识别二维码…" : root.rows.length > 0 ? "点击密钥或验证码即可复制" : "";
                font-size: 12px; color: root.edit-error != "" ? Skin.danger : root.feedback != "" ? Skin.accent : Skin.muted;
                wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
            }
            Action {
                label: "退出"; kind: "quiet"; enabled: !root.modal;
                y: (parent.height - self.height) / 2; height: 30px;
                triggered => { root.quit-app(); }
            }
        }
    }

    if root.modal: Rectangle {
        background: #20332b4d;
        // Consume pointer events throughout the scrim and beneath modal text.
        TouchArea {}
        FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape { root.close-dialog(); return accept; }
                return reject;
            }
            dialog := Paper {
                width: min(parent.width - 36px, 435px);
                height: contents.preferred-height;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                drop-shadow-color: #162a1e30;
                drop-shadow-blur: 18px; drop-shadow-offset-y: 5px;
                contents := VerticalLayout {
                    padding: 21px; spacing: 12px;
                    Heading {
                        text: root.page == "import" ? "导入条目" : root.page == "delete" ? "删除条目"
                            : root.draft.id == "" ? "添加条目" : "编辑条目";
                    }
                    if root.page == "edit": VerticalLayout {
                        spacing: 7px;
                        Caption { text: "名称"; }
                        name-input := DraftInput {
                            height: 36px; placeholder-text: "服务或账号名称"; accessible-label: "名称";
                            draft-value: root.draft.name; edited(value) => { root.draft.name = value; }
                            init => { self.focus(); }
                        }
                        Caption { text: "密钥"; }
                        DraftInput {
                            height: 36px; placeholder-text: "Base32 密钥"; accessible-label: "密钥";
                            draft-value: root.draft.secret; edited(value) => { root.draft.secret = value; }
                        }
                        HorizontalLayout {
                            spacing: 9px; height: 62px;
                            VerticalLayout {
                                spacing: 3px;
                                Caption { text: "位数"; }
                                DraftInput {
                                    height: 35px; min-width: 48px; accessible-label: "位数";
                                    draft-value: root.draft.digits; edited(value) => { root.draft.digits = value; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Caption { text: "周期（秒）"; }
                                DraftInput {
                                    height: 35px; min-width: 55px; accessible-label: "周期（秒）";
                                    draft-value: root.draft.period; edited(value) => { root.draft.period = value; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Caption { text: "算法"; }
                                ComboBox {
                                    accessible-label: "算法"; height: 35px; min-width: 108px;
                                    model: ["SHA1", "SHA256", "SHA512"];
                                    property <int> draft-index: root.draft.algorithm == "SHA512" ? 2 : root.draft.algorithm == "SHA256" ? 1 : 0;
                                    current-index: self.draft-index;
                                    changed draft-index => { self.current-index = self.draft-index; }
                                    selected(value) => { root.draft.algorithm = value; }
                                }
                            }
                        }
                    }
                    if root.page == "import": VerticalLayout {
                        spacing: 5px;
                        Caption { text: "验证器链接"; }
                        LineEdit {
                            height: 36px; placeholder-text: "otpauth://totp/…"; accessible-label: "验证器链接";
                            text <=> root.link; init => { self.focus(); }
                            accepted => { if !root.link.is-empty { root.import-uri(root.link); } }
                        }
                    }
                    if root.page == "delete": VerticalLayout {
                        spacing: 7px;
                        Text {
                            text: root.pending-name; color: Skin.ink; font-size: 16px; font-weight: 650;
                            overflow: elide; min-width: 0px;
                        }
                        Text { text: "删除后将无法再为此条目生成验证码。"; color: Skin.muted; font-size: 13px; wrap: word-wrap; }
                    }
                    if root.edit-error != "" || root.feedback != "": Text {
                        text: root.edit-error != "" ? root.edit-error : root.feedback;
                        color: root.edit-error != "" ? Skin.danger : Skin.muted;
                        font-size: 12px; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 36px; alignment: end; spacing: 8px;
                        Action {
                            label: "取消"; triggered => { root.close-dialog(); }
                            init => { if root.page == "delete" { self.focus(); } }
                        }
                        Action {
                            label: root.page == "edit" ? "保存条目" : root.page == "import" ? "解析链接" : "确认删除";
                            kind: root.page == "delete" ? "destructive" : "primary";
                            enabled: root.page != "import" || !root.link.is-empty;
                            triggered => {
                                if root.page == "edit" { root.save-entry(root.draft); }
                                else if root.page == "import" { root.import-uri(root.link); }
                                else { root.confirm-delete(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
